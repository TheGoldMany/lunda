// Core data model for the urgent-job slice of the service marketplace concept.
// See docs/concept/ for the full DEV/DESIGN source material.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum Trade {
  WATER
  GAS
  ELECTRICITY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Urgency {
  URGENT
  PLANNED
}

enum JobRequestStatus {
  OPEN
  BOOKED
  CANCELLED
}

enum BookingStatus {
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  CARD_MOCK
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role
  city         String
  createdAt    DateTime @default(now())

  serviceProvider ServiceProvider?
  jobRequests     JobRequest[]     @relation("CustomerJobRequests")
  reviewsWritten  Review[]         @relation("ReviewsWritten")
  reviewsReceived Review[]         @relation("ReviewsReceived")
  messagesSent    Message[]        @relation("MessagesSent")
}

model ServiceProvider {
  id                  String              @id @default(cuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id])
  trades              Trade[]
  calloutFee          Decimal             @db.Decimal(10, 2)
  hourlyRate          Decimal             @db.Decimal(10, 2)
  licenseDocumentUrl  String?
  verificationStatus  VerificationStatus  @default(PENDING)
  isAvailable         Boolean             @default(true)
  latitude            Float
  longitude           Float
  ratingAvg           Float?
  createdAt           DateTime            @default(now())

  bookings Booking[]
  quotes   Quote[]
}

model JobRequest {
  id              String            @id @default(cuid())
  customerId      String
  customer        User              @relation("CustomerJobRequests", fields: [customerId], references: [id])
  trade           Trade
  description     String
  photoUrl        String?
  address         String
  latitude        Float
  longitude       Float
  urgency         Urgency
  // Only set for PLANNED requests: the window the customer wants the work done in.
  preferredStartAt DateTime?
  preferredEndAt   DateTime?
  status          JobRequestStatus  @default(OPEN)
  createdAt       DateTime          @default(now())

  booking Booking?
  quotes  Quote[]
}

// Only created in the PLANNED flow: a provider's offer against a JobRequest.
// The customer compares quotes from multiple providers before accepting one.
model Quote {
  id                      String      @id @default(cuid())
  jobRequestId            String
  jobRequest              JobRequest  @relation(fields: [jobRequestId], references: [id])
  providerId              String
  provider                ServiceProvider @relation(fields: [providerId], references: [id])
  price                   Decimal     @db.Decimal(10, 2)
  estimatedDurationMinutes Int
  message                 String?
  proposedStartAt         DateTime?
  validUntil              DateTime
  status                  QuoteStatus @default(PENDING)
  createdAt               DateTime    @default(now())

  @@unique([jobRequestId, providerId])
}

model Booking {
  id            String        @id @default(cuid())
  jobRequestId  String        @unique
  jobRequest    JobRequest    @relation(fields: [jobRequestId], references: [id])
  providerId    String
  provider      ServiceProvider @relation(fields: [providerId], references: [id])
  status        BookingStatus @default(BOOKED)
  // Agreed appointment time for the planned flow; null for urgent bookings
  // (which start as soon as the provider arrives).
  scheduledAt   DateTime?
  finalPrice    Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  reviews  Review[]
  messages Message[]
  payment  Payment?
}

// Created once a booking is marked complete. Payment is mocked in this
// build (no real Barion/Stripe integration) — "paying" just flips status.
model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  commissionAmount  Decimal       @db.Decimal(10, 2)
  method            PaymentMethod @default(CARD_MOCK)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  paidAt            DateTime?
}

// Simple in-app chat between the customer and provider of a booking.
model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  senderId  String
  sender    User     @relation("MessagesSent", fields: [senderId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

// Reviews are bidirectional: the customer rates the provider and the
// provider rates the customer, so each booking can have up to two reviews.
model Review {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  reviewerId  String
  reviewer    User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  score       Int
  text        String?
  createdAt   DateTime @default(now())

  @@unique([bookingId, reviewerId])
}
